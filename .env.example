# Copy to .env and set the real key locally. Never commit .env.
GEMINI_API_KEY=your_api_key_here

# Persistent local ChromaDB storage (OD-7, ADR-0005): repo-local, git-ignored, rebuilt by script.
CHROMA_PATH=data/chroma

# Embedding settings (ADR-0004 D10, ADR-0005). Optional: the defaults in config.py apply when unset.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=40
# EMBEDDING_RPM=90
# EMBEDDING_TPM=25000
# EMBEDDING_MAX_ATTEMPTS=5
# EMBEDDING_TIMEOUT_S=60
# EMBEDDING_CACHE_PATH=data/cache/embeddings.sqlite
