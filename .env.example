# Copy to .env and set the real key locally. Never commit .env.
GEMINI_API_KEY=your_api_key_here

# Persistent local ChromaDB storage (OD-7, ADR-0005): repo-local, git-ignored, rebuilt by script.
# Relative paths here resolve from the repo root, not the working directory; absolute paths are kept.
CHROMA_PATH=data/chroma

# Embedding settings (ADR-0004 D10, ADR-0005). Optional: the defaults in config.py apply when unset.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=45
# EMBEDDING_RPM=90
# EMBEDDING_TPM=25000
# EMBEDDING_MAX_ATTEMPTS=5
# EMBEDDING_TIMEOUT_S=60
# EMBEDDING_CACHE_PATH=data/cache/embeddings.sqlite

# Providers. Embedding, generation and reranking are chosen separately.
# EMBEDDING_PROVIDER=gemini        # gemini | embeddinggemma (local, needs: pip install -e .[local])
# LLM_PROVIDER=gemini              # gemini | llamacpp (local GGUF through llama-server)
# LLAMACPP_URL=http://127.0.0.1:8080
# LOCAL_LLM_MODEL=qwen3.5-2b-instruct-q4_k_m   # required for llamacpp: the --alias llama-server was started with
# LOCAL_LLM_CHAT_TEMPLATE_KWARGS={"enable_thinking": false}
# LOCAL_LLM_SYSTEM_PROMPT=                     # optional, e.g. /no_think for models switched by a system line
# LOCAL_LLM_MAX_OUTPUT_TOKENS=512
# LOCAL_LLM_TIMEOUT_S=600
# LOCAL_LLM_SEED=42
# RERANK_PROVIDER=none             # none (default) | cross-encoder (opt-in "high quality" mode, ADR-0009: slow on CPU)
# Local cross-encoder (ONNX export folder with tokenizer.json + onnx/; the app never downloads it). Recommended
# opt-in: bge-reranker-v2-m3 int8, 10 candidates. The gate keeps reading the dense score (reranker gate PROVISIONAL).
# RERANK_MODEL_DIR=E:/models/rerankers/bge-reranker-v2-m3
# RERANK_VARIANT=int8              # int8 | fp32
# RERANK_CANDIDATES=10
# RERANK_MAX_TOKENS=512            # question + window per pair; windows overlap by RERANK_WINDOW_OVERLAP (MaxP)
# RERANK_WINDOW_OVERLAP=128
# RERANK_BATCH_SIZE=8
# RERANK_THREADS=0                 # 0 = ONNX Runtime default
# Retrieval mode (ADR-0007): dense (default, vector store only) | sparse (FTS5 BM25 only) | hybrid (RRF of both).
# sparse/hybrid need the keyword index built by scripts/ingestion/build_index.py. The gate always uses the dense top-1.
# RETRIEVAL_MODE=dense
# RRF_K=60
# KEYWORD_INDEX_DIR=data/keyword
# Local EmbeddingGemma v1 (ONNX, onnx-community export: tokenizer.json + onnx/). The app never downloads it.
# Each variant/dim is its own collection: rebuild the index (scripts/ingestion/build_index.py) after switching.
# The gate threshold defaults per provider (gemini 0.686, embeddinggemma 0.5417; retrieval-spec.md). The
# embeddinggemma value is tuned for fp32@768 ONLY: with another variant or dim it is an untested cutoff, so tune and set
# INSUFFICIENT_SCORE_THRESHOLD for that configuration.
# INSUFFICIENT_SCORE_THRESHOLD=   # set only to override that default
# LOCAL_EMBEDDING_MODEL_DIR=E:/models/embeddinggemma/gemma1
# LOCAL_EMBEDDING_VARIANT=fp32     # fp32 (default, ~1 GB peak) | int4 (low RAM, ~0.55 GB) | fp16 | int8
# LOCAL_EMBEDDING_DIM=768          # 768 | 512 | 256 | 128 (Matryoshka truncation)
# LOCAL_EMBEDDING_BATCH_SIZE=8
# LOCAL_EMBEDDING_THREADS=0        # 0 = ONNX Runtime default
# LOCAL_EMBEDDING_MAX_TOKENS=2048

# Other data paths (defaults in config.py).
# CHUNKS_DIR=data/processed/chunks
# LOGS_DIR=data/logs

# Answer generation (ADR-0004 D11-D13 + amendment 2026-09-26). Optional: the defaults in config.py apply when unset.
# ANSWER_MODEL=gemini-3.5-flash-lite
# FALLBACK_MODEL=gemini-3.5-flash
# ALLOW_FALLBACK=true              # the evaluation runner sets false: every answer then comes from ANSWER_MODEL
# ANSWER_MAX_ATTEMPTS=3            # 1 + 2 retries on the answer model, then one fallback attempt
# ANSWER_TIMEOUT_S=60
# Free-tier limits (AI Studio, 2026-09-26) and the client-side throttle, per model:
# ANSWER_LIMIT_RPM=15  ANSWER_LIMIT_TPM=250000  ANSWER_LIMIT_RPD=500  ANSWER_THROTTLE_RPM=13
# FALLBACK_LIMIT_RPM=5 FALLBACK_LIMIT_TPM=250000 FALLBACK_LIMIT_RPD=20 FALLBACK_THROTTLE_RPM=4
# FALLBACK_MAX_OUTPUT_TOKENS=2048 # output budget of the fallback call (the answer model keeps 1024)

# Low-memory Windows machines: limit the BLAS thread pool so numpy/chromadb do not fail allocating buffers.
OPENBLAS_NUM_THREADS=1
