# Copy to .env and set the real key locally. Never commit .env.
GEMINI_API_KEY=your_api_key_here

# Persistent local ChromaDB storage (OD-7, ADR-0005): repo-local, git-ignored, rebuilt by script.
# Relative paths here resolve from the repo root, not the working directory; absolute paths are kept.
CHROMA_PATH=data/chroma

# Embedding settings (ADR-0004 D10, ADR-0005). Optional: the defaults in config.py apply when unset.
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=45
# EMBEDDING_RPM=90
# EMBEDDING_TPM=25000
# EMBEDDING_MAX_ATTEMPTS=5
# EMBEDDING_TIMEOUT_S=60
# EMBEDDING_CACHE_PATH=data/cache/embeddings.sqlite

# Other data paths (defaults in config.py).
# CHUNKS_DIR=data/processed/chunks
# LOGS_DIR=data/logs

# Answer generation (ADR-0004 D11-D13 + amendment 2026-09-26). Optional: the defaults in config.py apply when unset.
# ANSWER_MODEL=gemini-3.5-flash-lite
# FALLBACK_MODEL=gemini-3.5-flash
# ALLOW_FALLBACK=true              # the evaluation runner sets false: every answer then comes from ANSWER_MODEL
# ANSWER_MAX_ATTEMPTS=3            # 1 + 2 retries on the answer model, then one fallback attempt
# ANSWER_TIMEOUT_S=60
# Free-tier limits (AI Studio, 2026-09-26) and the client-side throttle, per model:
# ANSWER_LIMIT_RPM=15  ANSWER_LIMIT_TPM=250000  ANSWER_LIMIT_RPD=500  ANSWER_THROTTLE_RPM=13
# FALLBACK_LIMIT_RPM=5 FALLBACK_LIMIT_TPM=250000 FALLBACK_LIMIT_RPD=20 FALLBACK_THROTTLE_RPM=4
